{
  "Sync": {
    "ServerIP": "127.0.0.1",
    "Port": 3306,
    "TimeoutMs": 5000
  },
  "Session": {
    "IdleTimeoutMinutes": 20,
    "WarningLeadSeconds": 60
  },
  "Connection": {
    "HealthCheckIntervalSeconds": 15,
    "RetryBackoffSeconds": [2, 4, 8, 16, 32],
    "MaxRetries": 5
  },
  "Client": {
    "WorkstationName": "Workstation-1"
  },
  "Receipts": {
    "Archival": {
      "Enabled": true,
      "IntervalHours": 24,
      "BatchSize": 100
    }
  },
  "POS": {
    "Receipt": {
      "Target": "Console",
      "Pdf": {
        "OutputDirectory": "Receipts",
        "FileNamePattern": "OR-{ReceiptNumber}.pdf",
        "FontFamily": "Courier New",
        "FontSizePt": 9
      }
    }
  }
}
