<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <OptionStrict>On</OptionStrict>
    <RootNamespace>MerchSys.App</RootNamespace>
    <StartupObject>Sub Main</StartupObject>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>

  <ItemGroup>
    <Import Include="System.Data" />
    <Import Include="System.Drawing" />
    <Import Include="System.Windows.Forms" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MerchSys.SharedKernel\MerchSys.SharedKernel.vbproj" />
    <ProjectReference Include="..\MerchSys.Purchasing\MerchSys.Purchasing.vbproj" />
    <ProjectReference Include="..\MerchSys.Inventory\MerchSys.Inventory.vbproj" />
    <ProjectReference Include="..\MerchSys.POS\MerchSys.POS.vbproj" />
    <ProjectReference Include="..\MerchSys.Accounting\MerchSys.Accounting.vbproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Konscious.Security.Cryptography.Argon2" Version="1.3.0" />
    <PackageReference Include="MediatR" Version="14.1.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.7" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.7">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="10.0.12" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.12" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.12" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.12" />
    <PackageReference Include="MySql.EntityFrameworkCore" Version="10.0.7" />
    <PackageReference Include="MySqlConnector" Version="2.5.0" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Data\Migrations\Central\**\*.sql">
      <LogicalName>%(RecursiveDir)%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <!-- The BIR receipt-archive immutability triggers (H3). Applied by
         ReceiptArchiveTriggerBootstrapper as a startup step of its own, AFTER the EF model has
         created the archive table — not by MariaDbSchemaInitializer, whose versioned-migration
         sweep runs first and would fail because the table does not exist yet. The file is the
         canonical copy the infrastructure runbook points at; the .ddl logical name deliberately
         does not end in .sql so that sweep leaves it alone. -->
    <EmbeddedResource Include="..\..\Plans\VISTA_Modules\Infrastructure\sql\02-pos-receipt-integrity-triggers.sql">
      <LogicalName>02-pos-receipt-integrity-triggers.ddl</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <!-- The application's base configuration. Without this rule it is never copied to the
         output, so a deployed client has no appsettings.json at all and every setting in it
         (Session, Connection, Receipts, POS) silently falls back to code defaults. -->
    <None Update="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="MerchSys.Tests" />
  </ItemGroup>

</Project>