<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <RootNamespace>MerchSys.Tests</RootNamespace>
    <OptionStrict>On</OptionStrict>
    <IsPackable>false</IsPackable>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.InMemory" Version="10.0.7" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="Moq" Version="4.21.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="MySql.EntityFrameworkCore" Version="10.0.7" />
    <PackageReference Include="MySqlConnector" Version="2.5.0" />
  </ItemGroup>

    <ItemGroup>
    <ProjectReference Include="..\..\src\MerchSys.SharedKernel\MerchSys.SharedKernel.vbproj" />
    <ProjectReference Include="..\..\src\MerchSys.Inventory\MerchSys.Inventory.vbproj" />
    <ProjectReference Include="..\..\src\MerchSys.Purchasing\MerchSys.Purchasing.vbproj" />
    <ProjectReference Include="..\..\src\MerchSys.POS\MerchSys.POS.vbproj" />
    <ProjectReference Include="..\..\src\MerchSys.Accounting\MerchSys.Accounting.vbproj" />
    <ProjectReference Include="..\..\src\MerchSys.App\MerchSys.App.vbproj" />
  </ItemGroup>
</Project>
