<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <RootNamespace>MerchSys.Tests</RootNamespace>
    <OptionStrict>On</OptionStrict>
    <IsPackable>false</IsPackable>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <!-- Declared explicitly even though MerchSys.App already brings both in transitively. The tests
       use these types directly: MySqlConnection / MySqlConnectionStringBuilder to create and drop
       the throwaway integration database, and UseMySQL to build real DbContexts. Depending on the
       transitive path means any future prune of these references from MerchSys.App silently breaks
       the test project's compilation. -->
  <ItemGroup>
    <PackageReference Include="MySql.EntityFrameworkCore" Version="10.0.7" />
    <PackageReference Include="MySqlConnector" Version="2.5.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\MerchSys.SharedKernel\MerchSys.SharedKernel.vbproj" />
    <ProjectReference Include="..\..\src\MerchSys.App\MerchSys.App.vbproj" />
  </ItemGroup>

</Project>
