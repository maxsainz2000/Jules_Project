    <Fact>
    Public Sub FinancialOverviewView_ShouldHaveExpectedSemanticTags()
        Dim view As New FinancialOverviewView()

        ' Need to get private components generated by designer via reflection
        Dim getControl = Function(name As String) As Control
                             Dim propInfo = view.GetType().GetProperty(name, Reflection.BindingFlags.NonPublic Or Reflection.BindingFlags.Instance)
                             Return DirectCast(propInfo.GetValue(view), Control)
                         End Function

        Assert.Equal("PrimaryMetricValue", getControl("lblMtdRevenue").Tag)
        Assert.Equal("SecondaryMetricValue", getControl("lblTodayRevenue").Tag)
        Assert.Equal("SecondaryMetricValue", getControl("lblGrossMarginToday").Tag)
        Assert.Equal("SecondaryMetricValue", getControl("lblTotalAR").Tag)
        Assert.Equal("SecondaryMetricValue", getControl("lblTotalAP").Tag)
        Assert.Equal("MetricCaption", getControl("lblYtdRevenue").Tag)
        Assert.Equal("MetricCaption", getControl("lblInventoryValue").Tag)
        Assert.Equal("TertiaryMetricCard", getControl("pnlVatTile").Tag)
    End Sub

