    <Fact>
    Public Sub ThemeService_ShouldApplyThemeToDashboardViewsWithoutException()
        Dim themeService As New ThemeService()
        themeService.SetTheme(AppTheme.Dark)

        Dim views As Control() = {
            New OwnerDashboardView(),
            New FinancialOverviewView(),
            New SalesSummaryView(),
            New VatReturnView(),
            New VatReliefReportView(),
            New IncomeStatementView(),
            New StockDashboardView(),
            New ExpiryMonitorView(),
            New ShrinkageView(),
            New APLedgerView()
        }

        For Each view In views
            ' If no exception is thrown, the test passes.
            Dim exception As Exception = Record.Exception(Sub() themeService.ApplyTheme(view))
            Assert.Null(exception)
        Next
    End Sub
End Class
